{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/system.schema.json",
  "type": "object",
  "required": ["student", "prefix", "public_url", "ui", "azure", "services"],
  "properties": {
    "student": {"type": "string"},
    "prefix": {"type": "string"},
    "public_url": {"type": "string"},
    "ui": {
      "type": "object",
      "required": ["path", "storage_account", "calls"],
      "properties": {
        "path": {"type": "string"},
        "storage_account": {"type": "string"},
        "calls": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "azure": {
      "type": "object",
      "required": ["resource_group", "container_apps_environment", "sql_server", "sql_server_location", "registry"],
      "properties": {
        "resource_group": {"type": "string"},
        "container_apps_environment": {"type": "string"},
        "sql_server": {"type": "string"},
        "sql_server_location": {"type": "string"},
        "registry": {"type": "string"}
      },
      "additionalProperties": false
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["description", "path", "openapi", "port_default", "health", "migrations", "env", "calls", "azure"],
        "properties": {
          "description": {"type": "string"},
          "path": {"type": "string"},
          "openapi": {"type": "string"},
          "port_default": {"type": "integer"},
          "health": {"type": "string"},
          "migrations": {"type": "string"},
          "env": {"type": "object"},
          "calls": {"type": "array"},
          "azure": {
            "type": "object",
            "required": ["container_app", "sql_database"],
            "properties": {
              "container_app": {"type": "string"},
              "sql_database": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
